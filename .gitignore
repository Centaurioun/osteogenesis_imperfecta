# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Envs and secrets
.env
.env.*
env.local

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# pytype / mypy / ruff
.mypy_cache/
.ruff_cache/

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# macOS
.DS_Store

# Windows
Thumbs.db

# Node
node_modules/

# Logs
*.log
logs/

# Jupyter
.ipynb_checkpoints

# Database files
*.sqlite3

# Secrets/keys
*.pem
*.key
secrets/

# Large or generated data
data/
dist-packages/

# Misc
*.swp
